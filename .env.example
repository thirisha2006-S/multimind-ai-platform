# MultiMind AI Platform Environment Variables copy this file to .env and fill in your keys

# Application
APP_NAME=MultiMind AI Platform
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=development

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Cohere API
COHERE_API_KEY=your-cohere-api-key-here
COHERE_MODEL=command

# Tavily Search API
TAVILY_API_KEY=your-tavily-api-key-here

# Database (SQLite by default)
DATABASE_URL=sqlite:///./data/multimind.db

# FAISS Vector Store
FAISS_INDEX_PATH=./data/vector_store/faiss_index

# Security
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
