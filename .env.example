# Multimind AI Platform Environment Variables

# Application
APP_NAME=Multimind AI Platform
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=production

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimind

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o

# Security
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma
